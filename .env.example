# URL del proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (pública) del proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima

# Clave service-role del proyecto Supabase (Project Settings -> API -> service_role).
# SECRETA: solo se usa en el server (sin prefijo NEXT_PUBLIC_ para que no entre al bundle).
# La usan el borrado de cuenta (auth.admin.deleteUser) y el envío de notificaciones push
# (lee las suscripciones de otros perfiles, que su RLS no deja ver desde el cliente). En
# Vercel va como env var del entorno de producción, no en el repo.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL pública del sitio, usada para construir redirects de auth (magic link / OAuth)
# En local: http://localhost:3000 — en Vercel: la URL del deploy de producción
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones push (Web Push). El par se genera una sola vez con `npx web-push
# generate-vapid-keys` y no se regenera nunca —cambiarlo invalida todas las suscripciones
# ya guardadas—. La pública lleva NEXT_PUBLIC_ porque el navegador la necesita para
# suscribirse (`pushManager.subscribe`); la privada es secreta, solo firma el envío en el
# server. `VAPID_SUBJECT` es un contacto (mailto: o URL) que va en cada request a los
# servicios push, por si necesitan avisarte de algo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid
VAPID_SUBJECT=https://yalope.com

# API key de Google Maps Platform (Places API + Geocoding API), usada por el
# autocompletado de ubicaciones. Es pública por diseño, igual que la clave anónima de
# Supabase: su seguridad depende de restringirla por HTTP referrer y por API en Google
# Cloud Console, y de fijarle una cuota diaria tope.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps
