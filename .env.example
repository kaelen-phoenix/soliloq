# URL del proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (pública) del proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima

# Clave service-role del proyecto Supabase (Project Settings -> API -> service_role).
# SECRETA: solo se usa en el server (sin prefijo NEXT_PUBLIC_ para que no entre al bundle).
# Hoy solo la usa el borrado de cuenta (auth.admin.deleteUser). En Vercel va como env var
# del entorno de producción, no en el repo.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL pública del sitio, usada para construir redirects de auth (magic link / OAuth)
# En local: http://localhost:3000 — en Vercel: la URL del deploy de producción
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API key de Google Maps Platform (Places API + Geocoding API), usada por el
# autocompletado de ubicaciones. Es pública por diseño, igual que la clave anónima de
# Supabase: su seguridad depende de restringirla por HTTP referrer y por API en Google
# Cloud Console, y de fijarle una cuota diaria tope.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps
